{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist/main",
    "sourceMap": true
  },
  "include": ["src/main", "src/preload", "src/application", "src/persistence", "src/domain", "src/shared", "src/fixtures"]
}
